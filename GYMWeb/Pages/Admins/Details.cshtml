@page
@model GYMWeb.Pages.Admins.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Admin Details</h1>

<div class="card">
    <div class="card-body">
        <h4 class="card-title">Admin Information</h4>  @* Card Title *@
        <hr />
        <dl class="row">
            <dt class="col-sm-3 glowing-header">
                @* Added glowing-header class *@
                @Html.DisplayNameFor(model => model.Admin.userName).ToString().ToUpper()
            </dt>
            <dd class="col-sm-9 glowing-text">
                @* Added glowing-text class *@
                @Html.DisplayFor(model => model.Admin.userName)
            </dd>
            <dt class="col-sm-3 glowing-header">
                @* Added glowing-header class *@
                @Html.DisplayNameFor(model => model.Admin.password).ToString().ToUpper()
            </dt>
            <dd class="col-sm-9 glowing-text">
                @* Added glowing-text class *@
                @Html.DisplayFor(model => model.Admin.password)
            </dd>
        </dl>

        <div class="mt-3 d-flex justify-content-end">
            @* Flexbox for buttons *@
            <a asp-page="./Edit" asp-route-id="@Model.Admin.Id" class="btn btn-warning me-2">Edit</a> @* Margin added *@
            <a asp-page="/Index" class="btn glowing-button">Log Out</a> @* Danger button for logout *@
        </div>
    </div>
</div>


<div class="mt-3">
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Related Sections</h5>
            <a asp-page="/Members/Index" class="btn btn-info me-2">View Members</a> @* Margin added *@
            <a asp-page="/Employees/Index" class="btn btn-info">View Employees</a>
        </div>
    </div>
</div>