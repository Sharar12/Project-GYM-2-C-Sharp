@page
@model GYMWeb.Pages.Action.AdminSignInModel
@{
    ViewData["Title"] = "Admin Sign In";
}

<h1 class="text-center">Admin Sign In</h1> @* Centered heading *@
<hr />

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @* Dismissable alert *@
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row justify-content-center">
    @* Centered form *@
    <div class="col-md-6">
        @* Adjusted column width *@
        <div class="card">
            @* Card for the form *@
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-floating mb-3">
                        @* Floating label and margin bottom added *@
                        <input asp-for="userName" class="form-control" placeholder="Username" required /> @* Placeholder and required added *@
                        <label asp-for="userName">Username</label>
                        <span asp-validation-for="userName" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        @* Floating label and margin bottom added *@
                        <input asp-for="password" type="password" class="form-control" placeholder="Password" required /> @* Placeholder, password type, and required added *@
                        <label asp-for="password">Password</label>
                        <span asp-validation-for="password" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        @* Full-width button *@
                        <button type="submit" class="btn btn-primary">Sign In</button> @* Button tag for better semantics *@
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="mt-3 text-center">
    @* Centered link and margin top added *@
    <a asp-page="SignIn" class="btn btn-secondary">Back to User Sign In</a> @* Button style added *@
</div>