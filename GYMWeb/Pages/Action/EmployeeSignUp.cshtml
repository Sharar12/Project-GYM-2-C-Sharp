@page
@model GYMWeb.Pages.Action.EmployeeSignUpModel
@{
    ViewData["Title"] = "Employee Sign Up";
}

<h1 class="text-center">Employee Sign Up</h1>
<hr />

<h4 class="text-center">Employee</h4>
<hr />

<div class="d-flex justify-content-center">
    <div class="col-md-8">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Employee.name" class="control-label"></label>
                        <input asp-for="Employee.name" class="form-control" />
                        <span asp-validation-for="Employee.name" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Employee.address" class="control-label"></label>
                        <input asp-for="Employee.address" class="form-control" />
                        <span asp-validation-for="Employee.address" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Employee.email" class="control-label"></label>
                        <input asp-for="Employee.email" class="form-control" />
                        <span asp-validation-for="Employee.email" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Employee.password" class="control-label"></label>
                        <input asp-for="Employee.password" type="password" class="form-control" />
                        <span asp-validation-for="Employee.password" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Integer fields (age, experience, and phone) in the same row -->
            <div class="row mt-3">
                <div class="col-md-4">
                    <div class="form-group mb-3">
                        <label asp-for="Employee.age" class="control-label"></label>
                        <input asp-for="Employee.age" class="form-control" />
                        <span asp-validation-for="Employee.age" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group mb-3">
                        <label asp-for="Employee.experience" class="control-label"></label>
                        <input asp-for="Employee.experience" class="form-control" />
                        <span asp-validation-for="Employee.experience" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group mb-3">
                        <label asp-for="Employee.phone" class="control-label"></label>
                        <input asp-for="Employee.phone" class="form-control" />
                        <span asp-validation-for="Employee.phone" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Dropdowns (gender, role, and schedule) in the same row -->
            <div class="row mt-3">
                <div class="col-md-4">
                    <div class="form-group mb-3">
                        <label asp-for="Employee.gender" class="control-label"></label>
                        <select asp-for="Employee.gender" class="form-control">
                            <option value="">-- Select Gender --</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                        <span asp-validation-for="Employee.gender" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group mb-3">
                        <label asp-for="Employee.role" class="control-label"></label>
                        <select asp-for="Employee.role" class="form-control">
                            <option value="">-- Select Role --</option>
                            <option value="Personal Trainer">Personal Trainer</option>
                            <option value="Receptionist">Receptionist</option>
                            <option value="Medic">Medic</option>
                        </select>
                        <span asp-validation-for="Employee.role" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group mb-3">
                        <label asp-for="Employee.schedule" class="control-label"></label>
                        <select asp-for="Employee.schedule" class="form-control">
                            <option value="">-- Select Schedule --</option>
                            <option value="Morning Shift (6 AM - 2 PM)">Morning Shift (6 AM - 2 PM)</option>
                            <option value="Afternoon Shift (2 PM - 10 PM)">Afternoon Shift (2 PM - 10 PM)</option>
                            <option value="Night Shift (10 PM - 6 AM)">Night Shift (10 PM - 6 AM)</option>
                        </select>
                        <span asp-validation-for="Employee.schedule" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Centered Submit Button -->
            <div class="form-group text-center mt-4">
                <input type="submit" value="Create" class="btn btn-primary w-50" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
