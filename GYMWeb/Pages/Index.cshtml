@page
@model GYMWeb.Pages.IndexModel
@{
    ViewData["Title"] = "Welcome to GYM Fitness";
}

<div class="container text-center">
    <img src="/images/logo.jpg" alt="GYMWeb Logo" class="img-fluid mb-4" width="150">  @* Margin bottom added *@
    <h1 class="display-4 fw-bold">Welcome to GYM Fitness</h1> @* Added fw-bold *@
    <p class="lead"><b>Your fitness journey starts here! Choose a package that fits your needs and get started today.</b></p>

    <div class="mt-4 d-flex justify-content-center">
        @* Centered buttons *@
        <a asp-page="Action/MemberSignUp" class="btn btn-lg btn-outline-dark me-3">Sign Up</a> @* Margin added *@
        <a asp-page="Action/SignIn" class="btn btn-lg btn-dark">Sign In</a> @* Removed inline styles, use CSS *@
    </div>
</div>

<hr class="my-5"> @* Margin top and bottom added *@

<section class="container text-center mb-5">
    @* Container and margin bottom added *@
    <h2>Why Choose GYM Fitness?</h2>
    <p>State-of-the-art equipment, certified trainers, and the best facilities to help you achieve your fitness goals.</p>

    <div class="row">
        @* Images in a row for better responsiveness *@
        <div class="col-md-4 mb-4">
            @* Column and margin bottom added *@
            <img src="/images/1.jpg" class="img-fluid rounded" alt="GYM Facility" loading="lazy"> @* Rounded corners and loading="lazy" *@
        </div>
        <div class="col-md-4 mb-4">
            @* Column and margin bottom added *@
            <img src="/images/2.jpg" class="img-fluid rounded" alt="Workout Area" loading="lazy"> @* Rounded corners and loading="lazy" *@
        </div>
        <div class="col-md-4 mb-4">
            @* Column and margin bottom added *@
            <img src="/images/3.jpg" class="img-fluid rounded" alt="Personal Training" loading="lazy"> @* Rounded corners and loading="lazy" *@
        </div>
    </div>
</section>

<hr class="my-5"> @* Margin top and bottom added *@

<section class="container text-center mb-5">
    @* Container and margin bottom added *@
    <h2>Our Membership Packages</h2>

    <div class="row mt-4">
        <div class="col-md-4 mb-4">
            @* Column and margin bottom added *@
            <div class="card border-primary h-100">
                @* Card and h-100 added *@
                <div class="card-header bg-primary text-white">
                    <h3>Basic Package</h3>
                </div>
                <div class="card-body d-flex flex-column">
                    @* Flexbox for card body *@
                    <p><strong>Price:</strong> TK.3000/month</p>
                    <p><strong>Discount:</strong> 10% off for 6 months subscription: Tk.2700/month</p>
                    <ul class="list-unstyled flex-grow-1">
                        @* flex-grow-1 for list *@
                        <li>✅ Access to gym equipment</li>
                        <li>❌ No Locker room access</li>
                        <li>❌ No personal trainer</li>
                    </ul>
                    <a href="#" class="btn btn-danger">Choose Plan</a> @* Button and margin top added *@
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            @* Column and margin bottom added *@
            <div class="card border-success h-100">
                @* Card and h-100 added *@
                <div class="card-header bg-success text-white">
                    <h3>Standard Package</h3>
                </div>
                <div class="card-body d-flex flex-column">
                    @* Flexbox for card body *@
                    <p><strong>Price:</strong> TK.5000/month</p>
                    <p><strong>Discount:</strong> 40% off for 6 months subscription: Tk.3000/month</p>
                    <ul class="list-unstyled flex-grow-1">
                        @* flex-grow-1 for list *@
                        <li>✅ Access to gym equipment</li>
                        <li>✅ Locker room access</li>
                        <li>✅ Personal trainer</li>
                    </ul>
                    <a href="#" class="btn btn-danger">Choose Plan</a> @* Button and margin top added *@
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            @* Column and margin bottom added *@
            <div class="card border-danger h-100">
                @* Card and h-100 added *@
                <div class="card-header bg-danger text-white">
                    <h3>Premium Package</h3>
                </div>
                <div class="card-body d-flex flex-column">
                    @* Flexbox for card body *@
                    <p><strong>Price:</strong> TK.8000/month</p>
                    <p><strong>Discount:</strong> 50% off for 6 months subscription: Tk.4000/month</p>
                    <ul class="list-unstyled flex-grow-1">
                        @* flex-grow-1 for list *@
                        <li>✅ Access to all gym equipment</li>
                        <li>✅ Locker room & Sauna access</li>
                        <li>✅ Personal trainer</li>
                        <li>✅ Free nutrition consultation</li>
                    </ul>
                    <a href="#" class="btn btn-danger">Choose Plan</a> @* Button and margin top added *@
                </div>
            </div>
        </div>
    </div>
</section>

<div class="mt-4 text-center mb-5">
    @* Margin bottom added *@
    <a asp-page="Action/EmployeeSignUp" class="glowing-button">Join Our Team</a> 
</div>