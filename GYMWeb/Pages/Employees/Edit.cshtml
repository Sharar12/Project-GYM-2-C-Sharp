@page
@model GYMWeb.Pages.Employees.EditModel

@{
    ViewData["Title"] = "Edit Employee";
}

<h1 class="text-center">Edit Employee</h1>
<hr />

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Employee.Id" />

                    <!-- Name and Email in one row -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Employee.name" class="form-control" placeholder="Name" required />
                                <label asp-for="Employee.name">Name</label>
                                <span asp-validation-for="Employee.name" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Employee.email" class="form-control" placeholder="Email" required />
                                <label asp-for="Employee.email">Email</label>
                                <span asp-validation-for="Employee.email" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Address and Password in one row -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Employee.address" class="form-control" placeholder="Address" required />
                                <label asp-for="Employee.address">Address</label>
                                <span asp-validation-for="Employee.address" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Employee.password" class="form-control" placeholder="Password" type="password" required />
                                <label asp-for="Employee.password">Password</label>
                                <span asp-validation-for="Employee.password" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Age, Phone, Gender in one row -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <div class="form-floating">
                                <input asp-for="Employee.age" class="form-control" placeholder="Age" type="number" required />
                                <label asp-for="Employee.age">Age</label>
                                <span asp-validation-for="Employee.age" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating">
                                <input asp-for="Employee.phone" class="form-control" placeholder="Phone" required />
                                <label asp-for="Employee.phone">Phone</label>
                                <span asp-validation-for="Employee.phone" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating">
                                <select asp-for="Employee.gender" class="form-control" required>
                                    <option value="">-- Select Gender --</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>
                                <label asp-for="Employee.gender">Gender</label>
                                <span asp-validation-for="Employee.gender" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Role, Experience, Schedule in one row -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <div class="form-floating">
                                <select asp-for="Employee.role" class="form-control" required>
                                    <option value="">-- Select Role --</option>
                                    <option value="Personal Trainer">Personal Trainer</option>
                                    <option value="Receptionist">Receptionist</option>
                                    <option value="Medic">Medic</option>
                                </select>
                                <label asp-for="Employee.role">Role</label>
                                <span asp-validation-for="Employee.role" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating">
                                <input asp-for="Employee.experience" class="form-control" placeholder="Experience" required />
                                <label asp-for="Employee.experience">Experience</label>
                                <span asp-validation-for="Employee.experience" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating">
                                <select asp-for="Employee.schedule" class="form-control" required>
                                    <option value="">-- Select Schedule --</option>
                                    <option value="Morning">Morning</option>
                                    <option value="Afternoon">Afternoon</option>
                                    <option value="Evening">Evening</option>
                                </select>
                                <label asp-for="Employee.schedule">Schedule</label>
                                <span asp-validation-for="Employee.schedule" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <div class="d-grid gap-2 mt-4">
                        <input type="submit" value="Save" class="btn glowing-button" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="mt-3 text-center">
    <a asp-page="./Index" class="btn btn-danger">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
