<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GYMWeb</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GYMWeb.styles.css" asp-append-version="true" />

    <style>
        /* Global dark theme */
        body {
            background-color: #121212;
            color: #e0e0e0;
        }

        /* Navbar styling */
        .navbar {
            background-color: #1e1e1e;
            border-bottom: 2px solid #00eaff;
            box-shadow: 0px 2px 10px rgba(0, 234, 255, 0.3);
        }

        .navbar-brand, .nav-link {
            color: #ffffff !important;
            transition: 0.3s;
        }

            .nav-link:hover {
                color: #00eaff !important;
                text-shadow: 0px 0px 10px #00eaff;
            }

        /* Main container */
        .container {
            background-color: #1a1a1a;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0px 0px 15px rgba(0, 234, 255, 0.2);
        }

        /* Buttons */
        .btn-primary {
            background-color: #00eaff;
            border: none;
        }

            .btn-primary:hover {
                background-color: #008fb3;
                box-shadow: 0px 0px 15px #00eaff;
            }

        /* Footer */
        footer {
            background-color: #1e1e1e;
            color: #aaaaaa;
            padding: 10px;
            text-align: center;
            border-top: 2px solid #00eaff;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark">
            <div class="container">
                <img src="~/images/logo.jpg" alt="GYMWeb Logo" width="130" height="100" class="d-inline-block align-text-top">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    
                    GYM Fitness
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer>
        <p>&copy; 2025 GYMWeb. All rights reserved.</p>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
